#!/usr/bin/env node
// pwx — playwright-cli no Edge de automação (perfil próprio em ~/.browser-automation), via CDP.
// Uso: pwx [papel] <comando playwright-cli...>   ex.: pwx goto https://x.com · pwx snapshot · pwx click e12 · pwx close-tab · pwx gc
// Cada sessão do Claude (ou projeto, fora dele) ganha a PRÓPRIA janela por papel, fechada quando o Claude termina; os logins são os do perfil do papel, compartilhados por todos.
// O Edge de um papel fecha sozinho quando fica sem janela de sessão e sem aba do usuário; o próximo pwx o religa.
// Duas janelas na mesma sessão: PWX_SESSION=<nome> pwx …   Papel padrão do projeto: .pwx.json { "defaultRole": "admin" }
// Janela que passa de uma sessão do Claude para a próxima (um run de orquestrador): PWX_SESSION=<run> PWX_OWNER_PID=<pid do orquestrador>;
// fecha com PWX_SESSION=<run> pwx close-tab (todos os papéis) ou quando o orquestrador morre.
const fs = require('fs'), path = require('path'), os = require('os');
const { spawn, spawnSync, execSync } = require('child_process');

const HOME = path.join(os.homedir(), '.browser-automation');
const cfg = JSON.parse(fs.readFileSync(path.join(HOME, 'config.json'), 'utf8'));
const args = process.argv.slice(2);

function projectDefaultRole() {
  for (let d = process.cwd(); d !== path.dirname(d); d = path.dirname(d)) {
    const f = path.join(d, '.pwx.json');
    if (fs.existsSync(f)) return JSON.parse(fs.readFileSync(f, 'utf8')).defaultRole;
  }
}
function projectName() {
  try { return path.basename(execSync('git rev-parse --show-toplevel', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()); }
  catch { return path.basename(process.cwd()); }
}

let role = process.env.PWX_ROLE || projectDefaultRole() || cfg.defaultRole;
if (cfg.roles[args[0]]) role = args.shift();
// cada sessão do Claude ganha a própria aba: duas sessões no mesmo projeto não dividem (nem fecham) a janela uma da outra
// PWX_OWNER_PID: a janela vive enquanto esse processo viver, não a sessão do Claude que a abriu (o run de um orquestrador que encadeia sessões);
// PWX_OWNER_PID=0: de processo nenhum — só fecha com close-tab (ou pelo gc, 12 h parada)
const OWNER = process.env.CLAUDE_CODE_SESSION_ID || null, OWNER_PID = Number(process.env.PWX_OWNER_PID || process.env.CLAUDE_PID) || null;
const base = process.env.PWX_SESSION || (OWNER ? `${projectName()}-${OWNER.slice(0, 6)}` : projectName());
const session = `${role}-${base.replace(/[^\w.-]/g, '_')}`;

if (!args.length || (args[0] === '--help' && args.length === 1)) {
  console.log('uso: pwx [papel] <comando playwright-cli...>   ·   pwx [papel] run <script> [args...]\npapéis: ' + Object.keys(cfg.roles).join(', ') +
    '\nex.: pwx goto https://mail.google.com · pwx snapshot · pwx click e12 · pwx close-tab · pwx run fluxo.mjs\nsessão atual: ' + session);
  process.exit(0);
}

// sem depender do PATH do chamador (hook SessionEnd, shell sem nvm): playwright-cli mora ao lado deste node, browser ao lado deste script
const env = {
  ...process.env,
  PATH: `${path.dirname(process.execPath)}${path.delimiter}${process.env.PATH || ''}`,
  NODE_OPTIONS: `${process.env.NODE_OPTIONS || ''} --require "${path.join(__dirname, 'pwx-background.cjs')}"`.trim(),   // aba nova sem roubar o foco
};
const cli = (a) => spawnSync('playwright-cli', a, { stdio: 'pipe', encoding: 'utf8', env });
function browserUp() {   // sobe o Edge do papel se não estiver de pé
  const up = spawnSync(process.execPath, [path.join(__dirname, 'browser'), 'up', role], { stdio: 'pipe', encoding: 'utf8', env });
  if (up.status !== 0) { process.stderr.write(up.stdout + up.stderr); process.exit(1); }
}
// a aba de cada sessão fica registrada com o dono: ao reconectar volta para ela; quando o Claude que a abriu termina, ela fecha
const cdpOf = (r) => `http://127.0.0.1:${cfg.roles[r]}`;
const CDP = cdpOf(role);
const SESSIONS = path.join(HOME, 'sessions');
const REG = path.join(SESSIONS, `${session}.json`);
const pagesOf = async (r) => (await (await fetch(`${cdpOf(r)}/json/list`, { signal: AbortSignal.timeout(2000) })).json()).filter((t) => t.type === 'page');
const targets = () => pagesOf(role);
const read = (f) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return null; } };
const registered = () => read(REG)?.targetId ?? null;
const alive = (pid) => { try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; } };
const ageOf = (f) => { try { return Date.now() - fs.statSync(f).mtimeMs; } catch { return Infinity; } };
const records = () => { try { return fs.readdirSync(SESSIONS).filter((f) => f.endsWith('.json')).map((f) => ({ f, file: path.join(SESSIONS, f), rec: read(path.join(SESSIONS, f)) })).filter((x) => x.rec); } catch { return []; } };
const roleOf = ({ f, rec }) => rec.role || f.split('-')[0];
// conexão (ou `pwx run`) em andamento no papel: o Edge não pode ser encerrado como ocioso enquanto o pwx que a marcou estiver vivo
const UP = (r) => path.join(SESSIONS, `.up-${r}-${process.pid}`);
const touchUp = (r) => { fs.mkdirSync(SESSIONS, { recursive: true }); fs.writeFileSync(UP(r), ''); };
const untouchUp = (r) => fs.rmSync(UP(r), { force: true });
const upPid = (f) => Number(f.slice(f.lastIndexOf('-') + 1));
const connecting = (r, except) => { try { return fs.readdirSync(SESSIONS).some((f) => f.startsWith(`.up-${r}-`) && upPid(f) !== except && alive(upPid(f))); } catch { return false; } };
function register(targetId) {
  fs.mkdirSync(SESSIONS, { recursive: true });
  fs.writeFileSync(REG, JSON.stringify({ targetId, role, session, owner: OWNER, pid: OWNER_PID }) + '\n');
  if (OWNER_PID) watch(OWNER_PID);
}
// o Edge do papel fecha quando ninguém o usa: nenhuma janela de sessão viva nele e só abas vazias (uma aba do usuário o segura)
const BLANK = /^(about:blank|edge:\/\/newtab|chrome:\/\/new-?tab|https:\/\/ntp\.msn\.com\/edge\/ntp)/;
async function quitIdle(roles) {
  await Promise.all([...new Set(roles)].map(async (r) => {   // em paralelo: cada Edge leva ~2 s para sair, e o hook tem 15 s
    if (!cfg.roles[r] || connecting(r)) return;
    let pages;
    try { pages = await pagesOf(r); } catch { return; }   // fora do ar
    if (pages.some((t) => !BLANK.test(t.url))) return;
    if (records().some((x) => roleOf(x) === r && (pages.some((t) => t.id === x.rec.targetId) || ageOf(x.file) < 60e3))) return;
    await new Promise((ok) => spawn(process.execPath, [path.join(__dirname, 'browser'), 'down', r], { stdio: 'ignore', env }).on('close', ok));
  }));
}
// abas do papel com quem as abriu (openerId), que o /json/list não traz
async function openers(r) {
  try {
    const { webSocketDebuggerUrl } = await (await fetch(`${cdpOf(r)}/json/version`, { signal: AbortSignal.timeout(2000) })).json();
    const ws = new WebSocket(webSocketDebuggerUrl);
    await new Promise((ok, fail) => { ws.onopen = ok; ws.onerror = fail; setTimeout(fail, 2000); });
    const res = await new Promise((ok, fail) => { ws.onmessage = (e) => ok(JSON.parse(e.data)); ws.send(JSON.stringify({ id: 1, method: 'Target.getTargets' })); setTimeout(fail, 2000); });
    ws.close();
    return res.result.targetInfos.filter((t) => t.type === 'page');
  } catch { return []; }
}
// a aba da sessão e tudo que ela abriu (link target=_blank, window.open), em cadeia: o popup é da sessão e fecha com ela
const family = (pages, id) => {
  const ids = [id];
  for (let i = 0; i < ids.length; i++) for (const t of pages) if (t.openerId === ids[i] && !ids.includes(t.targetId)) ids.push(t.targetId);
  return ids;
};
// fecha pela id da janela registrada, nunca pela "aba atual" do daemon (que muda para a aba de outro quando a nossa é fechada à mão)
async function closeWhere(match) {
  const touched = [], pagesByRole = {};
  for (const x of records()) {
    if (!match(x.rec, x.file)) continue;
    const r = roleOf(x);
    if (cfg.roles[r] && x.rec.targetId) {
      const ids = family(pagesByRole[r] ??= await openers(r), x.rec.targetId);
      await Promise.all(ids.map((id) => fetch(`${cdpOf(r)}/json/close/${id}`, { signal: AbortSignal.timeout(2000) }).catch(() => {})));
    }
    cli(['-s=' + (x.rec.session || x.f.slice(0, -5)), 'detach']);
    fs.rmSync(x.file, { force: true });
    touched.push(r);
  }
  await quitIdle(touched);
}
// órfãs: dono morreu (crash, reboot, vigia morto), registro sem dono parado há mais de 12 h ou janela que já não existe no Edge de pé;
// depois, todo Edge que ficou sem uso fecha
async function gc() {
  const open = {};   // papel → abas, só dos Edges de pé
  for (const r of Object.keys(cfg.roles)) try { open[r] = (await pagesOf(r)).map((t) => t.id); } catch {}
  await closeWhere((rec, file) => {
    const ids = open[rec.role];
    if (ids && rec.targetId && !ids.includes(rec.targetId) && ageOf(file) > 60e3) return true;
    return rec.pid ? !alive(rec.pid) : ageOf(file) > 12 * 3600e3;
  });
  try { for (const f of fs.readdirSync(SESSIONS)) if ((/^\.watch-\d+$/.test(f) && !alive(Number(f.slice(7)))) || (/^\.up-/.test(f) && !alive(upPid(f))) || (/^\.lock-/.test(f) && !alive(Number(read(path.join(SESSIONS, f))) || -1))) fs.rmSync(path.join(SESSIONS, f), { force: true }); } catch {}
  await quitIdle(Object.keys(open));
}
// vigia, um por processo do Claude: quando ele some (/exit, Ctrl+C, terminal fechado, crash), fecha todas as janelas que abriu
function watch(pid) {
  const lock = path.join(SESSIONS, `.watch-${pid}`);
  const w = Number(read(lock));
  if (w && alive(w)) return;
  const child = spawn(process.execPath, [__filename, '__watch', String(pid)], { detached: true, stdio: 'ignore', env });
  fs.writeFileSync(lock, String(child.pid));
  child.unref();
}
// a janela registrada desta sessão ainda existe (Edge fora do ar conta como não)
const ours = async () => { const id = registered(); try { return !!id && (await targets()).some((t) => t.id === id); } catch { return false; } };

// uma conexão por vez na sessão: comandos em paralelo no começo abriam uma aba cada, e só uma ficava registrada (as outras, em branco e sem dono)
const LOCK = path.join(SESSIONS, `.lock-${session}`);
async function attach(force) {
  fs.mkdirSync(SESSIONS, { recursive: true });
  for (;;) {
    try { fs.writeFileSync(LOCK, String(process.pid), { flag: 'wx' }); break; }
    catch { const p = Number(read(LOCK)); if (p && !alive(p)) fs.rmSync(LOCK, { force: true }); else await new Promise((s) => setTimeout(s, 200)); }
  }
  touchUp(role);
  try { if (force || !(await ours())) { cli(['-s=' + session, 'detach']); await connect(); } }   // quem esperou a trava encontra a aba pronta
  finally { untouchUp(role); fs.rmSync(LOCK, { force: true }); }
}
// A página da sessão não abre janela nem aba nova: link `target=_blank`, `window.open` e form com target vão na
// MESMA aba. No macOS, aba/janela aberta pela página ATIVA o Edge e o traz para a frente — com o modo visível
// (`browser show`) isso arrancava a janela da frente do usuário a cada clique. Prevenir em vez de esconder depois:
// sem janela nova, nada a ativar. De quebra a página nova fica na aba que o agente lê. Instalado pelo daemon do
// playwright-cli (`run-code`), que segue de pé entre os comandos e reaplica a cada navegação (`addInitScript`).
// Exceção: popup de login (Google, Apple, Microsoft, Facebook, GitHub…) abre como popup de verdade — o fluxo
// devolve o login à página que o abriu (window.opener); na mesma aba ele fica preso em branco (gsi/transform).
const SAME_TAB = `async (page) => {
  const sameTab = () => {
    if (window.__pwxSameTab) return;
    window.__pwxSameTab = true;
    const go = (u) => { try { location.assign(new URL(String(u), location.href).href); } catch {} };
    const open = window.open;
    const login = (u) => { try { const x = new URL(String(u), location.href); return /(^|\\.)(accounts\\.google\\.com|appleid\\.apple\\.com|login\\.microsoftonline\\.com|login\\.live\\.com)$/i.test(x.hostname) || /oauth|\\/authorize/i.test(x.pathname); } catch { return false; } };
    window.open = function (url, ...rest) { if (!url || login(url)) return open.call(window, url, ...rest); go(url); return window; };
    const elsewhere = (t) => !!t && !/^(_self|_top|_parent)$/i.test(t);
    document.addEventListener('click', (e) => {
      const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
      if (!a || !elsewhere(a.target)) return;
      e.preventDefault(); e.stopImmediatePropagation(); go(a.href);
    }, true);
    document.addEventListener('submit', (e) => {
      if (e.target instanceof HTMLFormElement && elsewhere(e.target.target)) e.target.target = '_self';
    }, true);
  };
  await page.addInitScript(sameTab);
  await page.evaluate(sameTab).catch(() => {});
}`;
const sameTab = () => cli(['-s=' + session, 'run-code', SAME_TAB]);

async function connect() {
  await gc();
  browserUp();
  const before = await targets();
  const r = cli(['attach', `--cdp=${CDP}`, `--session=${session}`]);
  if (r.status !== 0) { process.stderr.write(r.stdout + r.stderr); process.exit(r.status || 1); }
  const attached = await targets();
  const opened = attached.find((t) => !before.some((b) => b.id === t.id));   // Edge sem aba nenhuma: o attach abre uma, e ela é a janela da sessão
  const old = before.find((t) => t.id === registered());
  if (old) {   // a aba ainda existe: seleciona pela URL quando ela é única entre as abas
    const hits = [...cli(['-s=' + session, 'tab-list']).stdout.matchAll(/^- (\d+):.*\]\((.*)\)\s*$/gm)].filter((m) => m[2] === old.url);
    if (hits.length === 1 && cli(['-s=' + session, 'tab-select', hits[0][1]]).status === 0) { sameTab(); return; }
    await fetch(`${CDP}/json/close/${old.id}`);   // não deu para achar: fecha a janela antiga e reabre no mesmo lugar
  }
  let created = opened;
  if (!created) {
    cli(['-s=' + session, 'tab-new']);   // aba própria: nunca mexe nas abas de outra sessão
    created = (await targets()).find((t) => !attached.some((b) => b.id === t.id));
  }
  if (created) register(created.id);
  sameTab();
  if (old && !/^(about|edge|chrome):/.test(old.url)) cli(['-s=' + session, 'goto', old.url]);
}

(async () => {
  if (args[0] === '__watch') {
    const pid = Number(args[1]);
    while (alive(pid)) await new Promise((s) => setTimeout(s, 2000));
    await closeWhere((rec) => rec.pid === pid);
    fs.rmSync(path.join(SESSIONS, `.watch-${pid}`), { force: true });
    process.exit(0);
  }
  if (args[0] === 'gc') { await gc(); process.exit(0); }
  if (args[0] === 'close-tab') {   // todas as janelas desta sessão do Claude, de todos os papéis e worktrees; com PWX_SESSION, as dessa sessão em todos os papéis
    const named = process.env.PWX_SESSION ? `-${process.env.PWX_SESSION.replace(/[^\w.-]/g, '_')}` : null;
    await closeWhere((rec, file) => file === REG || (named ? String(rec.session).endsWith(named) : OWNER && rec.owner === OWNER));
    console.log(`janelas da sessão ${OWNER && !process.env.PWX_SESSION ? OWNER : session} fechadas`);
    process.exit(0);
  }
  if (args[0] === 'run') {   // script Playwright próprio: conecta em PWX_CDP e, pelo preload, abre página sem roubar o foco
    touchUp(role);
    browserUp();
    const before = new Set((await targets()).map((t) => t.id));
    const s = spawnSync(process.execPath, args.slice(1), { stdio: 'inherit', env: { ...env, PWX_CDP: CDP } });
    // página que o script abriu e não fechou (erro no meio, esqueceu o close) fecha aqui: sem dono, seguraria o Edge para sempre como "aba do usuário"
    if (!connecting(role, process.pid)) {   // outro pwx conectando no papel: a janela nova pode ser a dele, ainda sem registro
      const mine = new Set(records().map((x) => x.rec.targetId));
      for (const t of await targets().catch(() => [])) if (!before.has(t.id) && !mine.has(t.id)) await fetch(`${CDP}/json/close/${t.id}`).catch(() => {});
    }
    untouchUp(role);
    await quitIdle([role]);
    process.exit(s.status ?? 1);
  }
  // mark: destaca um ponto da página para o print — quadrado vermelho com rótulo; `mark --hide` tira todas as marcas
  if (args[0] === 'mark') {
    if (args[1] === '--hide') args.splice(0, args.length, 'eval', `() => document.querySelectorAll('[data-pwx-mark]').forEach((m) => m.remove())`);
    else if (!args[1]) { console.error('uso: pwx mark <ref|seletor> [texto]   ·   pwx mark --hide'); process.exit(2); }
    else args.splice(0, args.length, 'eval', `(el) => {
      const r = el.getBoundingClientRect(), f = 6;
      const box = document.createElement('div'); box.setAttribute('data-pwx-mark', '');
      Object.assign(box.style, { position: 'absolute', left: (r.left + scrollX - f) + 'px', top: (r.top + scrollY - f) + 'px',
        width: (r.width + 2 * f) + 'px', height: (r.height + 2 * f) + 'px', border: '3px solid #e00', borderRadius: '4px',
        boxSizing: 'border-box', pointerEvents: 'none', zIndex: '2147483647' });
      const tag = document.createElement('span'); tag.textContent = ${JSON.stringify(args[2] || 'BUG')};
      Object.assign(tag.style, { position: 'absolute', left: '-3px', bottom: '100%', background: '#e00', color: '#fff',
        font: 'bold 13px/1.4 system-ui, sans-serif', padding: '1px 6px', borderRadius: '3px 3px 0 0', whiteSpace: 'nowrap' });
      box.append(tag); document.documentElement.append(box);
    }`, args[1]);
  }
  // a janela da sessão sumiu (fechada à mão, Edge reiniciado, primeira vez) → refaz antes: senão o daemon roda na aba de outra sessão
  // aba nova seria de ninguém e ficaria aberta: a sessão tem uma aba, e tab-new <url> vira goto nela
  if (args[0] === 'tab-new') {
    if (!args[1]) { console.log('pwx: a sessão tem uma aba só; abra outra página com pwx goto <url>'); process.exit(0); }
    args[0] = 'goto';
  }
  if (args[0] !== '--help' && !(await ours())) await attach();
  // erro de conexão no meio (daemon caiu) → refaz e tenta de novo
  let r = cli(['-s=' + session, ...args]);
  if (r.status !== 0 && /is not open|not connected|Browser has been closed|Target page, context or browser has been closed|disconnected|ECONNREFUSED/i.test(r.stdout + r.stderr)) {
    await attach(true);   // a aba pode estar de pé com o daemon caído: reconecta e volta para ela
    r = cli(['-s=' + session, ...args]);
  }
  process.stdout.write(r.stdout || ''); process.stderr.write(r.stderr || '');
  process.exit(r.status ?? 1);
})();
