#!/usr/bin/env node
// browser — Edge de automação, um perfil por papel, controlável via CDP sem pedir "Permitir".
// INVISÍVEL por padrão (headless): sem janela não há o que roubar o foco. Janela só quando o usuário pede (show).
// Uso: browser up|down|show|hide|status|add|endpoint [papel] [url]   ·   status: ● invisível · ◉ com janela · ○ fora do ar
const fs = require('fs'), path = require('path'), os = require('os');
const { spawn, execSync } = require('child_process');

const HOME = path.join(os.homedir(), '.browser-automation');
const CONFIG = path.join(HOME, 'config.json');
const cfg = JSON.parse(fs.readFileSync(CONFIG, 'utf8'));
const save = () => fs.writeFileSync(CONFIG, JSON.stringify(cfg, null, 2) + '\n');

const [cmd = 'status', roleArg, urlArg] = process.argv.slice(2);
const role = roleArg || cfg.defaultRole;
const portOf = (r) => {
  const p = cfg.roles[r];
  if (!p) { console.error(`papel "${r}" não existe. Papéis: ${Object.keys(cfg.roles).join(', ')}. Crie com: browser add ${r}`); process.exit(1); }
  return p;
};
const endpoint = (r) => `http://127.0.0.1:${portOf(r)}`;
const alive = async (r) => {
  try { return (await fetch(`${endpoint(r)}/json/version`, { signal: AbortSignal.timeout(800) })).ok; }
  catch { return false; }
};
const pidOnPort = (port) => {
  try { return execSync(`lsof -nP -iTCP:${port} -sTCP:LISTEN -t`, { encoding: 'utf8' }).trim().split('\n')[0]; }
  catch { return null; }
};

// modo visível do papel: marca que só `show` cria e todo `down` apaga — a próxima subida volta invisível
const VISIBLE = (r) => path.join(HOME, 'sessions', `.visible-${r}`);
const visible = (r) => fs.existsSync(VISIBLE(r));
// o modo REAL do Edge de pé (a marca diz o pedido; um Edge subido antes desta versão tem janela sem marca)
const headless = (r) => {
  const pid = pidOnPort(portOf(r));
  try { return !!pid && /--headless/.test(execSync(`ps -o command= -p ${pid}`, { encoding: 'utf8' })); } catch { return false; }
};

// headless manda "HeadlessEdg"/"HeadlessChrome" no user agent, e site com anti-bot estranha: o UA é o do Edge comum
function userAgent() {
  let version = '';
  try { version = execSync(`"${cfg.browserBinary}" --version`, { encoding: 'utf8', timeout: 5000 }).match(/(\d+(?:\.\d+)+)/)?.[1] || ''; } catch {}
  if (!version) return null;
  const os_ = process.platform === 'darwin' ? 'Macintosh; Intel Mac OS X 10_15_7' : process.platform === 'win32' ? 'Windows NT 10.0; Win64; x64' : 'X11; Linux x86_64';
  return `Mozilla/5.0 (${os_}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${version.split('.')[0]}.0.0.0 Safari/537.36 Edg/${version}`;
}

async function up(r, url) {
  if (await alive(r)) { console.log(`${r}: já está de pé em ${endpoint(r)}, ${headless(r) ? 'invisível' : 'VISÍVEL'}`); return; }
  if (!fs.existsSync(cfg.browserBinary)) { console.error(`navegador não encontrado: ${cfg.browserBinary}`); process.exit(1); }
  const profile = path.join(HOME, 'profiles', r);
  fs.mkdirSync(profile, { recursive: true });
  fs.mkdirSync(path.join(HOME, 'logs'), { recursive: true });
  const logFile = path.join(HOME, 'logs', `${r}.log`);
  const flags = [
    `--user-data-dir=${profile}`,
    ...(cfg.profileDirectory?.[r] ? [`--profile-directory=${cfg.profileDirectory[r]}`] : []),   // o CDP controla só o perfil com que o Edge abre
    `--remote-debugging-port=${portOf(r)}`,
    '--remote-debugging-address=127.0.0.1',
    '--no-first-run',
    '--no-default-browser-check',
    // troca de perfil do Edge (Guided/Smart Switch): login em login.microsoftonline.com de uma conta que outro perfil
    // do mesmo user-data-dir conhece (ex.: OAuth no tenant da empresa) é desviado para aquele perfil — a aba do pwx não
    // navega e o callback do OAuth cai num perfil sem a sessão do app. O CDP controla um perfil só: nada de desvio.
    '--disable-features=msGuidedSwitchAllowed,msGuidedSwitchLoginMicrosoftOnline,msGuidedSwitchLoginMicrosoftOnlineOrganizations,msGuidedSwitchToSmartSwitch,msGuidedSwitchToSmartSwitchPersonal,msSmartSwitch',
    // vários clientes trabalham ao mesmo tempo: aba em segundo plano não pode ficar lenta
    '--disable-background-timer-throttling',
    '--disable-renderer-backgrounding',
    '--disable-backgrounding-occluded-windows',
  ];
  const show = visible(r);
  const app = process.platform === 'darwin' ? cfg.browserBinary.match(/^(.*?\.app)\//)?.[1] : null;
  if (show && app) {
    // pedido do usuário: janela na frente, com a página que ele vai usar (login, conferir); `-n` = instância
    // ao lado do Edge pessoal dele
    spawn('open', ['-n', '-a', app, '--stdout', logFile, '--stderr', logFile, '--args', ...flags, ...(url ? [url] : [])], { detached: true, stdio: 'ignore' }).unref();
  } else {
    // headless: processo sem janela, sem Dock e sem ativação — pelo binário, nunca pelo `open` (que registra o
    // app e o traz para a frente). Mesmo perfil = mesmos logins.
    const ua = userAgent();
    if (!show) flags.push('--headless=new', '--window-size=1440,900', '--no-startup-window', ...(ua ? [`--user-agent=${ua}`] : []));
    else if (url) flags.push(url);
    const log = fs.openSync(logFile, 'a');
    spawn(cfg.browserBinary, flags, { detached: true, stdio: ['ignore', log, log] }).unref();
  }
  for (let i = 0; i < 60; i++) {
    if (await alive(r)) { console.log(`${r}: de pé em ${endpoint(r)}, ${show ? 'VISÍVEL' : 'invisível'} (perfil ${profile})`); return; }
    await new Promise((s) => setTimeout(s, 250));
  }
  console.error(`${r}: não respondeu em 15 s. Veja ${path.join(HOME, 'logs', `${r}.log`)}`); process.exit(1);
}

// pelo CDP (Browser.close) o perfil sai limpo — SIGTERM o marca como travado e a próxima abertura pede "Restaurar páginas?"
async function closeViaCdp(r) {
  try {
    const { webSocketDebuggerUrl } = await (await fetch(`${endpoint(r)}/json/version`, { signal: AbortSignal.timeout(800) })).json();
    const ws = new WebSocket(webSocketDebuggerUrl);
    await new Promise((ok, fail) => { ws.onopen = ok; ws.onerror = fail; setTimeout(fail, 2000); });
    ws.send(JSON.stringify({ id: 1, method: 'Browser.close' }));
  } catch { return false; }
  for (let i = 0; i < 40; i++) {
    if (!pidOnPort(portOf(r))) return true;
    await new Promise((s) => setTimeout(s, 250));
  }
  return false;
}

async function down(r) {
  fs.rmSync(VISIBLE(r), { force: true });   // a próxima subida volta invisível
  const pid = pidOnPort(portOf(r));
  if (!pid) { console.log(`${r}: já estava fora do ar`); return; }
  if (!(await closeViaCdp(r))) process.kill(Number(pid), 'SIGTERM');
  console.log(`${r}: encerrado (pid ${pid}). Os logins continuam salvos no perfil.`);
}

// janela só a pedido do usuário: reinicia o papel com janela (as sessões de pé reconectam sozinhas, na mesma URL)
async function showWindow(r, url) {
  await down(r);
  fs.mkdirSync(path.dirname(VISIBLE(r)), { recursive: true });
  fs.writeFileSync(VISIBLE(r), '');
  await up(r, url);
}
async function hideWindow(r) {
  await down(r);
  await up(r);
}

async function status() {
  for (const r of Object.keys(cfg.roles)) {
    const on = await alive(r), hidden = on && headless(r);
    console.log(`${on ? (hidden ? '●' : '◉') : '○'} ${r.padEnd(14)} ${endpoint(r)}${on ? (hidden ? '  invisível' : '  VISÍVEL') : ''}`);
  }
}

function add(r) {
  if (!roleArg) { console.error('uso: browser add <papel>'); process.exit(1); }
  if (cfg.roles[r]) { console.log(`${r} já existe na porta ${cfg.roles[r]}`); return; }
  const used = new Set(Object.values(cfg.roles));
  let port = 9222; while (used.has(port)) port++;
  cfg.roles[r] = port; save();
  console.log(`${r}: criado na porta ${port}. Suba com: browser up ${r}`);
}

(async () => {
  switch (cmd) {
    case 'up': return up(role);
    case 'down': return down(role);
    case 'show': return showWindow(role, urlArg);
    case 'hide': return hideWindow(role);
    case 'status': return status();
    case 'add': return add(role);
    case 'endpoint': return console.log(endpoint(role));
    default:
      console.log('uso: browser up|down|status|add|endpoint [papel]  ·  browser show <papel> [url] (janela, só a pedido do usuário)  ·  browser hide <papel>');
      process.exit(cmd === 'help' || cmd === '--help' ? 0 : 1);
  }
})();
