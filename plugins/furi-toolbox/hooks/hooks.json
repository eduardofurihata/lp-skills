{
  "description": "Hooks do /vac (vacina contra alucinação). Sempre registrados, dormentes até `/vac` criar ~/.claude/vac-data/vac/on (ou VAC_ON=1); `/vac off` remove. VAC=0 força desligado num processo. Custo desligado: um teste de arquivo em shell, sem Node.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" card --session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" card",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" card --subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" check-stop --subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" check-artifact",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" agent-done",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VAC\" = 0 ] && exit 0; [ \"$VAC_ON\" = 1 ] || [ -f \"$HOME/.claude/vac-data/vac/on\" ] || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/skills/vac/scripts/vac-hook.mjs\" check-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
